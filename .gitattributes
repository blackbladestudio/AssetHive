* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# The release includes a precompiled UE 5.5 plugin binary.
/AssetHive-UE-Plugin/AssetHive/Binaries/**/*.dll filter=lfs diff=lfs merge=lfs -text

# Model weights and fonts must never undergo line-ending conversion.
*.onnx binary
*.otf binary
*.ttf binary
